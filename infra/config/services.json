      "launcher": { "directory": "MasterPlanagent", "catalog": "masterplan_agent.json", "name": "MasterPlanAgent", "skill": "masterplan_health" },
      "depends_on": ["law"],
      "version_source": "card:version",
      "notes": "Asks Law over A2A (masterplanagent/clients/law_client.py)."
