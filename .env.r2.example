# Copy to .env.r2.local. Never commit the populated file.
# Keys are entered by the operator, not by the agent.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ALLOWED_ORIGINS=http://127.0.0.1:3003,http://localhost:3003

# New service outputs live outside both source repositories.
DATA_ROOT=C:/Data/25_ACE

# Empty URLs keep the existing local development readers.
NEXT_PUBLIC_BUILDINGS_BASE_URL=
NEXT_PUBLIC_WORLD_BUILDINGS_BASE_URL=
NEXT_PUBLIC_TERRAIN_BASE_URL=
SCENE_BUILDINGS_BASE_URL=
# <R2_PUBLIC_BASE_URL>/world-ground after infra/data/r2_ground.py --upload.
NEXT_PUBLIC_WORLD_GROUND_BASE_URL=
# Optional single release manifest URL; its assetBases binds all dataset URLs.
NEXT_PUBLIC_MAP_RELEASE_URL=
