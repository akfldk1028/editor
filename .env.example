# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# Public editor origin used by Mint OAuth and same-origin checks.
# Set this when Pascal is hosted outside editor.pascal.app.
# MINT_PASCAL_HOST_ORIGIN=https://pascal.example.com

# Absolute server-side directory for Editor-owned land analysis/audit storage.
# EDITOR_LAND_DATA_DIR=D:/Data/25_ACE/editor/runtime/editor/land
# EDITOR_DESIGN_DATA_DIR=D:/Data/25_ACE/editor/runtime/editor/design
#   Design data the backend expects under that root (copy or junction them in):
#   <root>/docs/260506/BOOK                 the 69 BOOK scans (maas/book-assets)
#   <root>/runtime/media/maas/aesthetic     aesthetic references/ and generated/

# Law graph (Neo4j). Unset means graph-backed enrichment is disabled; the same
# names are what ops/compose.yml hands the law containers.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Server-side law search providers. Unset providers return explicit partial results.
# LAW_BACKEND_URL=http://127.0.0.1:8011
# AG_LIGHT_URL=https://your-law-search-fallback.example

# Optional advisory extraction, never a numeric rule override. Requires OPENAI_API_KEY.
# LLM_EXTRACTION_ENABLED=false
# LLM_EXTRACTION_MODEL=gpt-4o-mini

# Optional absolute ground datum. Disabled by default; relative geometry is unchanged.
# ENABLE_DATUM_ELEVATION=false
# ELEVATION_PROVIDER=open_meteo
# Providers: open_meteo, ngii_lidar_1m (OpenTopoData), ngii_local_dem (install .[terrain]).
# NGII_LIDAR_URL=http://localhost:5000
# NGII_DEM_LOCAL_PATH=D:/terrain/dem.tif
# DATUM_EDGE_SUBSAMPLE=true
# DATUM_EDGE_SUBSAMPLE_THRESHOLD_M=10.0
# DATUM_EDGE_SUBSAMPLE_STEP_M=5.0
# DATUM_MEDIAN_FILTER=true
# DATUM_MEDIAN_FILTER_WINDOW=3

# Workspace model auth (backend/app/core/model_auth.py). Unset: "oauth" when the `claude` CLI is
# on PATH - local development runs agent teams on your Claude Code login, no API key - else "api_key".
# Deployment sets EDITOR_MODEL_AUTH=api_key and saves provider keys in /settings.
# EDITOR_MODEL_AUTH=
