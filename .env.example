# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# Public editor origin used by Mint OAuth and same-origin checks.
# Set this when Pascal is hosted outside editor.pascal.app.
# MINT_PASCAL_HOST_ORIGIN=https://pascal.example.com

# Absolute server-side directory for Editor-owned land analysis/audit storage.
# EDITOR_LAND_DATA_DIR=D:/Data/25_ACE/editor/runtime/editor/land

# Server-side law search providers. Unset providers return explicit partial results.
# LAW_BACKEND_URL=http://127.0.0.1:8011
# AG_LIGHT_URL=https://your-law-search-fallback.example

# Optional advisory extraction, never a numeric rule override. Requires OPENAI_API_KEY.
# LLM_EXTRACTION_ENABLED=false
# LLM_EXTRACTION_MODEL=gpt-4o-mini
