{
  "extends": "@pascal/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@planm/*": ["../planm/src/*"],
      "@click-around/workspace": ["../../../infra/services/dwg/apps/workspace/src/public.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx", "tools"],
  "references": [{ "path": "../../../resources/lib/core" }, { "path": "../../components/viewer" }]
}
