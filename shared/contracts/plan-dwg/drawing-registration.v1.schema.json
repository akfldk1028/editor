{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan.local/contracts/plan-dwg/drawing-registration.v1.schema.json",
  "title": "PLAN to DWG drawing registration request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "displayName"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000-\\u001F]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
