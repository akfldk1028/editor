{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-result/v1",
  "title": "PLANM Skill Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "skill_name",
    "status",
    "outputs",
    "violations",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "contract_version": { "const": "skill-result/v1" },
    "skill_name": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["success", "needs_input", "retryable", "blocked"]
    },
    "outputs": { "type": "object" },
    "violations": {
      "type": "array",
      "items": { "$ref": "#/$defs/violation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "hard"] },
        "retryable": { "type": "boolean" },
        "floor_index": { "type": ["integer", "null"], "minimum": 1 },
        "room_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "attempt", "input_sha256"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "attempt": { "type": "integer", "minimum": 1 },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "output_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
